# ملف إعدادات اختياري. تقدر تحط المفتاح من شاشة ⚙️ الإعدادات في الموقع بدل ما تعدل هنا.
# لو عملت ملف .env: انسخ ده باسم .env (بنفس المجلد). لا ترفع .env على GitHub ولا تشاركه.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# نموذج يفهم الصور (اختياري - غيّره لو Groq سحب النموذج ده)
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# قراءة محتوى الروابط اللي تتحط في الشات (true/false)
ENABLE_URL_FETCH=true
# على الاستضافة فقط (مش على جهازك): HOST=0.0.0.0
