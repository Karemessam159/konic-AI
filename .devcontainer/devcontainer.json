{
  "name": "Konic AI",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install",
  "postAttachCommand": "npm run dev:all",
  "forwardPorts": [5173, 3001],
  "portsAttributes": {
    "5173": { "label": "الموقع", "onAutoForward": "openBrowser" },
    "3001": { "label": "الخادم" }
  },
  "secrets": {
    "GROQ_API_KEY": { "description": "مفتاح Groq من console.groq.com/keys (اختياري: تقدر تحطه من شاشة الإعدادات)" }
  }
}
